# Environment Variables for AWS Deployment
# Copy this file to .env.local and fill in your values

# Node Environment
NODE_ENV=production

# Storage Configuration
USE_S3_STORAGE=true

# AWS Configuration (for S3 file uploads)
PANOR_AWS_REGION=us-east-1
PANOR_AWS_ACCESS_KEY_ID=your_aws_access_key_id
PANOR_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
PANOR_AWS_S3_BUCKET_NAME=your-panorama-bucket-name

# Panorama Configuration
PANORAMA_CONFIG_MODE=auto
PANORAMA_YAW_OFFSET=0
PANORAMA_PITCH_OFFSET=0
PANORAMA_CAMERA_OFFSET=1.6
PANORAMA_MAX_DISTANCE=10
PANORAMA_MAX_CONNECTIONS=5

# Next.js Public Variables (available in browser)
NEXT_PUBLIC_DEV_MODE=false
NEXT_PUBLIC_SHOW_DEBUG_INFO=false
NEXT_PUBLIC_PANOR_AWS_S3_BUCKET_NAME=your-panorama-bucket-name
NEXT_PUBLIC_PANOR_AWS_REGION=us-east-1

# File Upload Configuration
MAX_FILE_SIZE=100000000
UPLOAD_DIR=/tmp/uploads

# Application URL (set by Amplify automatically)
NEXT_PUBLIC_APP_URL=https://your-app-id.amplifyapp.com