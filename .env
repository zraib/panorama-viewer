# Environment Configuration for Panorama Viewer

# Storage Configuration
USE_S3_STORAGE=true

# AWS Configuration (for S3 file uploads)
# You need to replace these with your actual AWS credentials
PANOR_AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
PANOR_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
PANOR_AWS_S3_BUCKET_NAME=your_s3_bucket_name_here
PANOR_AWS_REGION=us-east-1

# Development Configuration
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# Note: Replace the AWS values above with your actual credentials
# 1. Create an S3 bucket in AWS Console
# 2. Create an IAM user with S3 permissions
# 3. Generate access keys for that user
# 4. Update the values above with your actual credentials